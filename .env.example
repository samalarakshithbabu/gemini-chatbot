# NEXORA AI - Environment Configuration Template
# Copy this file to .env and fill in your API keys

# Google API Key (Required for Chat, Research, Document Analysis)
# Get your API key from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Replicate API Token (Optional - for Video Generation)
# Video generation requires an external API. Get token from: https://replicate.com/account/api-tokens
# REPLICATE_API_TOKEN=your_replicate_token_here